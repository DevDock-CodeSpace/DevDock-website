# Copy to .env.local and fill in. .env.local is git-ignored; this file is committed.
# Variable names only here, never real values.
#
# Only VITE_-prefixed vars reach the browser, and everything in the bundle is PUBLIC.
# Never put a secret key (sb_secret_...), legacy service_role key, or database
# password in any VITE_ variable or anywhere in frontend code.

# Supabase: Dashboard → Project Settings → API Keys
VITE_SUPABASE_URL=
# Publishable key (sb_publishable_...). A legacy "anon" key also works until
# Supabase retires legacy keys, but prefer the publishable key.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Live sessions use Jitsi via JaaS (8x8). Its keys (JAAS_APP_ID, JAAS_KEY_ID,
# JAAS_PRIVATE_KEY) are Supabase Edge Function secrets, set with
# `supabase secrets set`, never VITE_ vars — they must not reach the browser.
